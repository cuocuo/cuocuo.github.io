#!name=WLOC - Apple Trust Asset Update Block
#!desc=Experimental three-domain block from Yu9191/wloc issue #195. May disrupt Apple software and security asset updates; does not guarantee preservation of previous trust asset versions.
#!homepage=https://github.com/Yu9191/wloc/issues/195

[Rule]
DOMAIN-SUFFIX,gdmf-ados.apple.com,REJECT
DOMAIN-SUFFIX,gdmf.apple.com,REJECT
DOMAIN-SUFFIX,updates-http.cdn-apple.com,REJECT
